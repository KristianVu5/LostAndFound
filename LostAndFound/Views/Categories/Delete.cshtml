@model LostAndFound.Models.Category

@{
    ViewData["Title"] = "Изтриване на категория";
}

<h1>Изтриване на категория</h1>
<p>Сигурен ли си, че искаш да изтриеш категорията "@Model.Name"?</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Index" class="btn btn-link">Отказ</a>
</form>

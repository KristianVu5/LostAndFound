@model IReadOnlyList<LostAndFound.Models.Category>
@{
    ViewData["Title"] = "Категории";
}

<h1> Категории</h1>
@if (TempData["DeleteError"] is string message)
{
    <div class="alert alert-warning" role="alert">
       @message
    </div>
}
<p>
    <a asp-action="Create" class="btn btn-primary">Добави категория</a>
</p>

@if (Model.Count == 0)
{
    <p>Все още няма добавени категории.</p>
}
else
{
    <ul>
        @foreach (var category in Model)
        {
            <li>
                @category.Name
                <a asp-action="Edit" asp-route-id="@category.Id">Редактирай</a>
                <a asp-action="Delete" asp-route-id="@category.Id">Изтрий</a>
            </li>
        }
    </ul>
}

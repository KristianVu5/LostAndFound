@model IReadOnlyList<LostAndFound.Models.Category>

@{
    ViewData["Title"] = "Категории";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Категории</h1>
        <p class="text-muted mb-0">Управление на видовете вещи в обявите.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Добави категория</a>
</div>

@if (TempData["DeleteError"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-light border" role="status">
        Все още няма създадени категории.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 80px;">№</th>
                    <th scope="col">Име на категорията</th>
                    <th scope="col" class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Count; index++)
                {
                    var category = Model[index];
                    <tr>
                        <td class="text-muted">@(index + 1)</td>
                        <td class="fw-semibold">@category.Name</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@category.Id"
                                   class="btn btn-sm btn-outline-secondary">Детайли</a>
                                <a asp-action="Edit" asp-route-id="@category.Id"
                                   class="btn btn-sm btn-outline-primary">Редактирай</a>
                                <a asp-action="Delete" asp-route-id="@category.Id"
                                   class="btn btn-sm btn-outline-danger">Изтрий</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@model LostAndFound.ViewModels.CategoryForm

@{
    ViewData["Title"] = "Редактиране на категория";
    var categoryId = (int)ViewData["CategoryId"]!;
}

<h1>Редактиране на категория</h1>

<form asp-action="Edit" asp-route-id="@categoryId" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Име на категорията</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-link">Към списъка</a>
</form>
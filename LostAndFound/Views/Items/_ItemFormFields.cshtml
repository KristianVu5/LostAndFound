@model LostAndFound.ViewModels.ItemForm

<div class="mb-3">
    <label asp-for="Title" class="form-label">Заглавие</label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">Описание</label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Location" class="form-label">Място</label>
    <input asp-for="Location" class="form-control" />
    <span asp-validation-for="Location" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="OccurredOn" class="form-label">Дата</label>
    <input asp-for="OccurredOn" type="date"
           asp-format="{0:yyyy-MM-dd}" class="form-control" />
    <span asp-validation-for="OccurredOn" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Type" class="form-label">Тип на обявата</label>
    <select asp-for="Type" class="form-select">
        <option value="">Избери тип</option>
        <option value="Lost">Изгубена вещ</option>
        <option value="Found">Намерена вещ</option>
    </select>
    <span asp-validation-for="Type" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label">Категория</label>
    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
        <option value="">Избери категория</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="PhotoFiles" class="form-label">Снимки (JPG или PNG)</label>
    <input asp-for="PhotoFiles" type="file" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control" />
    <span asp-validation-for="PhotoFiles" class="text-danger"></span>
    <div class="form-text">Можеш да избереш до 5 снимки във формат JPG или PNG, всяка до 5 MB.</div>
</div>

@model IReadOnlyList<Report>

@{
    ViewData["Title"] = "Обяви";
    var location = ViewData["Location"] as string;
    var dateFrom = ViewData["DateFrom"] as string;
    var dateTo = ViewData["DateTo"] as string;
    var selectedType = ViewData["Type"] is ItemType value
        ? value
        : (ItemType?)null;
    var currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 0);
    var selectedCategoryId = ViewData["CategoryId"] is int categoryValue
        ? categoryValue
        : (int?)null;
    var selectedTypeValue = selectedType.HasValue
        ? (int)selectedType.Value
        : (int?)null;
}

<h1>Обяви за изгубени и намерени вещи</h1>

@if (TempData["ItemCreated"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

@if (TempData["ItemDeleted"] is string deletedMessage)
{
    <div class="alert alert-success" role="status">@deletedMessage</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Нова обява</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="mb-2">
        <label for="type" class="form-label">Тип на обявата</label>
        <select id="type" name="type" class="form-select">
            <option value="">Всички типове</option>
            <option value="1" selected="@(selectedType == ItemType.Lost)">Изгубена</option>
            <option value="2" selected="@(selectedType == ItemType.Found)">Намерена</option>
        </select>
    </div>

    <div class="mb-2">
        <label for="categoryId" class="form-label">Категория</label>
        <select id="categoryId" name="categoryId"
                asp-items="ViewBag.Categories" class="form-select">
            <option value="">Всички категории</option>
        </select>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    <fieldset class="mb-3">
        <legend class="col-form-label pt-0">Период</legend>
        <div class="d-flex flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="dateFrom" class="mb-0">От</label>
                <input id="dateFrom" name="dateFrom" type="date"
                       value="@dateFrom" class="form-control w-auto" />
            </div>
            <div class="d-flex align-items-center gap-2">
                <label for="dateTo" class="mb-0">До</label>
                <input id="dateTo" name="dateTo" type="date"
                       value="@dateTo" class="form-control w-auto" />
            </div>
        </div>
    </fieldset>

    <label for="location" class="form-label">Място</label>
    <div class="input-group">
        <input id="location" name="location" value="@location"
               class="form-control" placeholder="Например: Варна" />
        <button type="submit" class="btn btn-primary">Търси</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
    </div>
</form>

@if (ViewData.ModelState.IsValid && Model.Count == 0)
{
    <p>@(ViewData["HasFilters"] is true
        ? "Няма обяви, които отговарят на избраните критерии."
        : "Все още няма публикувани обяви.")</p>
}
else if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Вещ</th>
                    <th scope="col">Тип</th>
                    <th scope="col">Категория</th>
                    <th scope="col">Място</th>
                    <th scope="col">Дата</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@report.Id">
                                @report.Item.Title
                            </a>
                        </td>
                        <td>@(report.Type == ItemType.Lost ? "Изгубена" : "Намерена")</td>
                        <td>@report.Item.Category.Name</td>
                        <td>@report.Location</td>
                        <td>@report.OccurredOn.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Страници с обяви">
            <ul class="pagination">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-location="@location"
                           asp-route-categoryId="@selectedCategoryId"
                           asp-route-dateFrom="@dateFrom"
                           asp-route-dateTo="@dateTo"
                           asp-route-type="@selectedTypeValue">
                            Предишна
                        </a>
                    </li>
                }

                <li class="page-item disabled">
                    <span class="page-link">Страница @currentPage от @totalPages</span>
                </li>

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-location="@location"
                           asp-route-categoryId="@selectedCategoryId"
                           asp-route-dateFrom="@dateFrom"
                           asp-route-dateTo="@dateTo"
                           asp-route-type="@selectedTypeValue">
                            Следваща
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@model Report

@{
    ViewData["Title"] = "Изтриване на обява";
}

<h1>Изтриване на обява</h1>
<p>Сигурен ли си, че искаш да изтриеш обявата за „@Model.Item.Title“?</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Изтрий</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Отказ</a>
</form>

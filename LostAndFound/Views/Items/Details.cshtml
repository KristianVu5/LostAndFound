@model Item

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>

<dl>
    <dt>Тип</dt>
    <dd>@(Model.Type == ItemType.Lost ? "Изгубена" : "Намерена")</dd>

    <dt>Категория</dt>
    <dd>@Model.Category.Name</dd>

    <dt>Място</dt>
    <dd>@Model.Location</dd>

    <dt>Дата</dt>
    <dd>@Model.OccurredOn.ToString("dd.MM.yyyy")</dd>

</dl>

<h2>Описание</h2>
<p>@Model.Description</p>

<a asp-action="Index">Към обявите</a>

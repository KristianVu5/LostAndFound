@model LostAndFound.ViewModels.ItemDetailsViewModel
@{
    ViewData["Title"] = Model.Item.Title;
    var item = Model.Item;
}

<h1>@item.Title</h1>

<dl>
    <dt>Тип</dt>
    <dd>@(item.Type == ItemType.Lost ? "Изгубена" : "Намерена")</dd>

    <dt>Категория</dt>
    <dd>@item.Category.Name</dd>

    <dt>Място</dt>
    <dd>@item.Location</dd>

    <dt>Дата</dt>
    <dd>@item.OccurredOn.ToString("dd.MM.yyyy")</dd>

</dl>

<h2>Описание</h2>
<p>@item.Description</p>

<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Редактирай</a>
<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Изтрий</a>
<a asp-action="Index" class="btn btn-link">Към обявите</a>

<h2>Възможни съвпадения</h2>

@if (Model.PotentialMatches.Count == 0)
{
    <p>Не са намерени възможни съвпадения.</p>
}
else
{
    <ul>
        @foreach (var match in Model.PotentialMatches)
        {
            <li>
                <a asp-action="Details" asp-route-id="@match.Id">@match.Title</a>
                — @match.Category.Name,
                @match.Location,
                @match.OccurredOn.ToString("dd.MM.yyyy")
            </li>
        }
    </ul>
}

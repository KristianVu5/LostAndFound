@model LostAndFound.ViewModels.ItemDetailsViewModel

@{
    var report = Model.Report;
    var item = report.Item;
    ViewData["Title"] = item.Title;
}

<h1>@item.Title</h1>

@if (TempData["ClaimMessage"] is string claimMessage)
{
    <div class="alert alert-success" role="status">@claimMessage</div>
}

@if (TempData["ClaimError"] is string claimError)
{
    <div class="alert alert-warning" role="alert">@claimError</div>
}

@if (item.Photos.Count > 0)
{
    <div class="d-flex flex-wrap gap-3 my-3">
        @foreach (var photo in item.Photos)
        {
            <img src="@photo.ImagePath"
                 alt="Снимка на @item.Title"
                 class="img-fluid rounded border"
                 style="max-height: 420px; object-fit: contain;" />
        }
    </div>
}
else
{
    <p class="text-muted">Към тази обява няма качени снимки.</p>
}

<dl>
    <dt>Тип на обявата</dt>
    <dd>@(report.Type == ItemType.Lost ? "Изгубена" : "Намерена")</dd>

    <dt>Категория</dt>
    <dd>@item.Category.Name</dd>

    <dt>Място</dt>
    <dd>@report.Location</dd>

    <dt>Дата</dt>
    <dd>@report.OccurredOn.ToString("dd.MM.yyyy")</dd>
</dl>

<h2>Описание на вещта</h2>
<p>@item.Description</p>

@if (Model.CanManage)
{
    <a asp-action="Edit" asp-route-id="@report.Id" class="btn btn-primary">Редактирай</a>
    <a asp-action="Delete" asp-route-id="@report.Id" class="btn btn-outline-danger">Изтрий</a>
}

<a asp-action="Index" class="btn btn-link">Към обявите</a>

@if (report.Type == ItemType.Found)
{
    <section class="mt-4">
        <h2>Заявка за собственост</h2>

        @if (Model.CanSubmitClaim)
        {
            @if (Model.HasSubmittedClaim)
            {
                <p>Вече сте изпратили заявка за тази вещ. Собственикът на обявата ще я прегледа.</p>
            }
            else
            {
                <p>Смятате, че тази вещ е ваша? Изпратете кратко съобщение до човека, който я е намерил.</p>
                <form asp-action="Claim" asp-route-id="@report.Id" method="post">
                    <div class="mb-3">
                        <label for="Message" class="form-label">Съобщение</label>
                        <textarea id="Message" name="Message" rows="4" maxlength="1000"
                                  class="form-control" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Изпрати заявка</button>
                </form>
            }
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <p>
                За да изпратите заявка, първо
                <a asp-area="Identity" asp-page="/Account/Login"
                   asp-route-returnUrl="@Url.Action("Details", "Items", new { id = report.Id })">влезте в профила си</a>.
            </p>
        }
    </section>
}

@if (Model.CanManage)
{
    <section class="mt-4">
        <h2>Заявки за тази обява</h2>

        @if (Model.Claims.Count == 0)
        {
            <p>Все още няма подадени заявки.</p>
        }
        else
        {
            @foreach (var claim in Model.Claims)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <p><strong>Подател:</strong> @claim.Claimant.Email</p>
                        <p><strong>Съобщение:</strong> @claim.Message</p>
                        <p><strong>Изпратена на:</strong> @claim.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                        <p>
                            <strong>Статус:</strong>
                            @(claim.Status switch
                            {
                                ItemClaimStatus.Pending => "Чака преглед",
                                ItemClaimStatus.Approved => "Одобрена",
                                ItemClaimStatus.Rejected => "Отхвърлена",
                                _ => "Неизвестен"
                            })
                        </p>

                        @if (claim.Status == ItemClaimStatus.Pending)
                        {
                            <form asp-action="ReviewClaim" asp-route-id="@report.Id" method="post" class="d-inline">
                                <input type="hidden" name="claimId" value="@claim.Id" />
                                <button type="submit" name="status" value="@((int)ItemClaimStatus.Approved)"
                                        class="btn btn-success">Одобри</button>
                            </form>
                            <form asp-action="ReviewClaim" asp-route-id="@report.Id" method="post" class="d-inline">
                                <input type="hidden" name="claimId" value="@claim.Id" />
                                <button type="submit" name="status" value="@((int)ItemClaimStatus.Rejected)"
                                        class="btn btn-outline-danger">Отхвърли</button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </section>
}

<h2 class="mt-4">Възможни съвпадения</h2>

@if (Model.PotentialMatches.Count == 0)
{
    <p>Не са намерени възможни съвпадения.</p>
}
else
{
    <ul>
        @foreach (var match in Model.PotentialMatches)
        {
            <li>
                <a asp-action="Details" asp-route-id="@match.Id">@match.Item.Title</a>
                — @match.Item.Category.Name,
                @match.Location,
                @match.OccurredOn.ToString("dd.MM.yyyy")
            </li>
        }
    </ul>
}

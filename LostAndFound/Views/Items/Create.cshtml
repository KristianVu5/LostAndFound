@model LostAndFound.ViewModels.ItemForm


@{
    ViewData["Title"] = "Нова обява";
}

<h1>Нова обява</h1>


<form asp-action="Create" method="post" enctype="multipart/form-data">
    <partial name="_ItemFormFields" model="Model" />

    <button type="submit" class="btn btn-primary">Публикувай</button>
    <a asp-action="Index" class="btn btn-link">Към обявите</a>

</form>

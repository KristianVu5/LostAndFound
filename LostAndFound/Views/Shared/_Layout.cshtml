@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123b43" />
    <title>@ViewData["Title"] - Намери ме</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LostAndFound.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light app-navbar">
            <div class="container">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
                        <rect width="40" height="40" rx="13" fill="currentColor" />
                        <path d="M17.5 9a8.5 8.5 0 1 0 5.2 15.2L29 30.5l2.1-2.1-6.3-6.3A8.5 8.5 0 0 0 17.5 9Zm0 3a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Z" fill="#fff" />
                        <path d="m15 17.5 1.7 1.7 3.7-4" fill="none" stroke="#f5a65b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>Намери <span class="brand-accent">ме</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Отвори менюто">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center app-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Items" asp-action="Index">Обяви</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">Категории</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin")
                            && string.Equals(
                                User.Identity?.Name,
                                Configuration["AdminEmail"],
                                StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Admins" asp-action="Index">Администратори</a>
                            </li>
                            <li class="nav-item dropdown">
                                <button type="button" class="nav-link dropdown-toggle"
                                        id="reportsMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    Справки
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="reportsMenu">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Reports"
                                           asp-action="ByPeriod">Обяви по период</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Reports"
                                           asp-action="LostByCategory">Изгубени вещи по категория</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Reports"
                                           asp-action="FoundByLocation">Намерени вещи по място</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Reports"
                                           asp-action="CategoryPopularity">Категории с най-много обяви</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Reports"
                                           asp-action="PotentialMatches">Обяви с възможни съвпадения</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Reports"
                                           asp-action="Statistics">Изгубени срещу намерени вещи</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item nav-auth-item">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container page-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container footer-inner">
            <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">Намери ме</a>
            <p>Платформа, която помага на изгубените вещи да се върнат при своите хора.</p>
            <a asp-area="" asp-controller="Items" asp-action="Index">Разгледай обявите <span aria-hidden="true">→</span></a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

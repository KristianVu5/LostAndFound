@model IReadOnlyList<LostAndFound.ViewModels.CategoryPopularityRow>

@{
    ViewData["Title"] = "Категории с най-много обяви";
}

<h1>Категории с най-много обяви</h1>

@if (Model.Count == 0)
{
    <p>Все още няма публикувани обяви.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Категория</th>
                <th scope="col" class="text-end">Брой обяви</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.CategoryName</td>
                    <td class="text-end">@row.ReportCount</td>
                </tr>
            }
        </tbody>
    </table>
}
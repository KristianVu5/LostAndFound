@{
    ViewData["Title"] = "Обяви по период";
}

<h1>Обяви по период</h1>
<p>Избери периода, през който вещта е изгубена или намерена.</p>

<form asp-controller="Reports" asp-action="ByPeriod" method="get"
      class="row g-3 align-items-end mb-4">
    <div class="col-sm-4">
        <label for="dateFrom" class="form-label">От дата</label>
        <input id="dateFrom" name="dateFrom" type="date" class="form-control"
               value="@Context.Request.Query["dateFrom"]" />
    </div>

    <div class="col-sm-4">
        <label for="dateTo" class="form-label">До дата</label>
        <input id="dateTo" name="dateTo" type="date" class="form-control"
               value="@Context.Request.Query["dateTo"]" />
    </div>

    <div class="col-sm-auto">
        <button type="submit" class="btn btn-primary">Покажи</button>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger"></div>

@if (ViewData.ModelState.IsValid)
{
    <p>Брой обяви: <strong>@Model.Count</strong></p>

    @if (Model.Count == 0)
    {
        <p>Няма обяви за избрания период.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Дата</th>
                    <th scope="col">Вещ</th>
                    <th scope="col">Място</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td>@report.OccurredOn.ToString("dd.MM.yyyy")</td>
                        <td>
                            <a asp-controller="Items" asp-action="Details"
                               asp-route-id="@report.Id">@report.Item.Title</a>
                        </td>
                        <td>@report.Location</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
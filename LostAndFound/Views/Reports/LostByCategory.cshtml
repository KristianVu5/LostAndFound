@using Microsoft.AspNetCore.Mvc.Rendering

@model IReadOnlyList<LostAndFound.Models.Report>

@{
    ViewData["Title"] = "Изгубени вещи по категория";
    var categories = (SelectList)ViewData["Categories"]!;
}

<h1>Изгубени вещи по категория</h1>

<form asp-controller="Reports" asp-action="LostByCategory" method="get"
      class="row g-3 align-items-end mb-4">
    <div class="col-sm-6">
        <label for="categoryId" class="form-label">Категория</label>
        <select id="categoryId" name="categoryId"
                asp-items="categories" class="form-select">
            <option value="">Всички категории</option>
        </select>
    </div>
    <div class="col-sm-auto">
        <button type="submit" class="btn btn-primary">Покажи</button>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger"></div>

@if (ViewData.ModelState.IsValid)
{
    <p>Изгубени вещи: <strong>@Model.Count</strong></p>

    @if (Model.Count == 0)
    {
        <p>Няма изгубени вещи за този избор.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Вещ</th>
                        <th scope="col">Категория</th>
                        <th scope="col">Дата</th>
                        <th scope="col">Място</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Items" asp-action="Details"
                                   asp-route-id="@report.Id">@report.Item.Title</a>
                            </td>
                            <td>@report.Item.Category.Name</td>
                            <td>@report.OccurredOn.ToString("dd.MM.yyyy")</td>
                            <td>@report.Location</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

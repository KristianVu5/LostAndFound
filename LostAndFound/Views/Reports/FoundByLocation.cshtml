@model IReadOnlyList<LostAndFound.Models.Report>


@{
    ViewData["Title"] = "Намерени вещи по място";
    var location = ViewData["Location"] as string;
}

<h1>Намерени вещи по място</h1>

<form asp-controller="Reports" asp-action="FoundByLocation" method="get"
      class="row g-3 align-items-end mb-4">
    <div class="col-sm-6">
        <label for="location" class="form-label">Място</label>
        <input id="location" name="location" type="search"
               value="@location" class="form-control" />
    </div>
    <div class="col-sm-auto">
        <button type="submit" class="btn btn-primary">Търси</button>
    </div>
</form>

<p>Намерени вещи <strong>@Model.Count</strong></p>

@if (Model.Count == 0)
{
    <p>Няма намерени вещи за това търсене.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Вещ</th>
                    <th scope="col">Място</th>
                    <th scope="col">Дата</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Items" asp-action="Details"
                               asp-route-id="@report.Id">@report.Item.Title</a>
                        </td>
                        <td>@report.Location</td>
                        <td>@report.OccurredOn.ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <h1 class="mb-4">@ViewData["Title"]</h1>

        <form id="account" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control"
                       autocomplete="username" aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">Имейл адрес</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control"
                       autocomplete="current-password" aria-required="true"
                       placeholder="Парола" />
                <label asp-for="Input.Password">Парола</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    Запомни ме
                </label>
            </div>

            <button id="login-submit" type="submit"
                    class="w-100 btn btn-lg btn-primary mb-3">
                Вход
            </button>

            <div class="d-flex flex-column gap-2">
                <a id="forgot-password" asp-page="./ForgotPassword">
                    Забравена парола?
                </a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                    Регистрация на нов потребител
                </a>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">
                    Изпрати отново имейла за потвърждение
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

